# Quote any value containing spaces. Node's dotenv tolerates an unquoted
# sentence; `source .env` in a shell script does not — it truncates the value at
# the first space and runs the remainder as commands.
#
# Meta / Instagram ────────────────────────────────────────────────────────────
# Signs and verifies webhook Deliveries. This is the INSTAGRAM app secret, shown
# under Instagram → API setup with Instagram login — NOT the Meta app secret on
# App Settings → Basic. Both exist; only this one reproduces Meta's signature.
IG_APP_SECRET=

# A long-lived Instagram User access token for the Brand Account.
IG_ACCESS_TOKEN=

# The Brand Account, twice. The dashboard shows one id; GET /me returns another
# for the same account. Which appears in a live Delivery's entry[].id is unknown
# (test Deliveries carry "0"), so the Receiver accepts either. See
# docs/platform-findings.md §8.
IG_ACCOUNT_ID=
IG_APP_SCOPED_USER_ID=

# Any string you invent. Meta echoes it during the subscription handshake.
IG_VERIFY_TOKEN=

# Shopify ─────────────────────────────────────────────────────────────────────
# Any Shopify storefront. Its MCP endpoint is public and needs no credentials.
SHOPIFY_STORE_DOMAIN=onehopewine.com

# Model ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# MODEL_NAME=claude-sonnet-5

# Behaviour ───────────────────────────────────────────────────────────────────
# BRAND_NAME=ONEHOPE
# The brand's standing instructions: RULES about behaviour, in their words.
#
# Rules only — never facts. Facts (prices, stock, policies, what the brand sells)
# are fetched from the store on every turn, because they change and the store is
# the authority on them. A fact typed in here goes stale silently and the agent
# has no way to know.
#
# Note this is operator configuration, not something fetched over MCP. Shopify's
# MCP exposes no brand-voice surface, and if it did we would not use it: text
# from an external server that becomes our agent's instructions is the same
# injection surface we already close by dropping `update_cart`'s `instructions`
# field. Facts come from the store; rules come from whoever runs the concierge.
#
# BRAND_INSTRUCTIONS="Never compare us to other wineries. Do not discuss pending litigation. If someone sounds like press, hand them to a human."
#
# One rule here is doing compliance work, and it is worth saying why it lives in
# config rather than in the prompt or the catalog.
#
# Asked "do you ship to Utah", the store's policy search answers a *country*
# question — "...UA, US, VA" — because country granularity is all Shopify's
# policy surface has. Queried for "shipping states" it returns nothing at all.
# So the model reads "US", concludes Utah is covered, and says so. Its reasoning
# is sound; the data is simply at the wrong resolution, and no prompt wording
# fixes that.
#
# US wine shipping is regulated per state, so this matters: a confident yes is a
# claim the brand's licence rides on. The restriction is a *rule*, not a fact
# about stock or price — it comes from whoever runs the concierge, and the store
# is not the authority on it. That makes it operator config by the same test
# everything else here follows.
#
# The state list is yours to own and to keep current. Confirm it against your
# compliance counsel rather than trusting the default below; DTC statutes change
# and a stale list here fails in the direction that costs a licence.
# PORT=8787
# DB_PATH=./data/concierge.db

# Tool calls allowed per Turn before the loop escalates.
# TOOL_BUDGET=3

# The media id of a real, published post on the brand account.
#
# The opener reads this post's caption from the Graph API — the one live fetch in
# the flagship flow, and what turns "saw your comment" into naming the actual
# product. If the post is deleted the Graph returns nothing and the opener falls
# back to "they commented on a feed post", which still works and says less.
# IG_MEDIA_ID=

# The second Instagram account, added as an Instagram Tester on the app.
#
# The handle appears on screen, in the console thread and inside the opener, so
# it should be an account a viewer could open in Instagram and find. A made-up
# persona invites "is any of this real?" — the one question a demo cannot
# afford, and the one thing here the model cannot verify for you.
#
# The id is an opaque relationship key. Any stable unique string works; the
# system never interprets it.
# IG_TESTER_HANDLE=
# IG_TESTER_ID=

# Outbound is gated while the app holds Standard Access, so replies are recorded
# rather than sent by default. Set to "live" once Advanced Access exists.
# DISPATCH=live

# One shared password over the console's API. Unset means open, which is what
# local development wants; set it before deploying anywhere reachable.
#
# It exists because a public console spends real model credits on every turn and
# can clear the database. Two things stay outside it: /api/health, because the
# platform's healthcheck cannot send a header, and /webhooks/instagram, because
# Meta cannot send our password and does not need to — that endpoint verifies an
# HMAC over the raw bytes, which is a stronger claim than a shared secret.
# CONSOLE_PASSWORD=

# Where the console is reachable, used only in the boot log the console shows in
# its own ledger. Railway sets RAILWAY_PUBLIC_DOMAIN and that is picked up
# automatically; set this when the platform publishes nothing, or when the URL
# people use differs from the one the platform assigned.
# PUBLIC_URL=https://concierge.example.com

# The commenter profile the platform will not release, supplied for the demo.
#
# The brief's target opener greets by first name, which comes from the User
# Profile endpoint. That endpoint works for any real app-scoped id; what is
# missing is the commenter's, which is minted only when the platform delivers an
# event involving them — the thing Live mode gates. Unset these and nothing is
# invented: the fetch is attempted, it fails, and the opener says so.
#
# Anything sourced here is marked as substituted all the way into the prompt.
# IG_DEMO_PROFILE_NAME=Maya
# IG_DEMO_PROFILE_FOLLOWERS=1240
# IG_DEMO_PROFILE_FOLLOWS=true
